{
    "domain": "bluetti_modbus",
    "name": "BLUETTI Modbus",
    "codeowners": ["@Patrick762", "@chpego"],
    "config_flow": true,
    "dependencies": ["modbus"],
    "documentation": "https://github.com/bluetti-community/hassio-bluetti-modbus",
    "integration_type": "device",
    "iot_class": "local_polling",
    "issue_tracker": "https://github.com/bluetti-community/hassio-bluetti-modbus/issues",
    "requirements": [
        "modbus-connection[tmodbus]>=4.12.4",
        "tmodbus[async-serial]>=0.6.1"
    ],
    "version": "3.0.0",
    "zeroconf": [
        {
            "type": "_bluetti._tcp.local.",
            "name": "smeter*"
        },
        {
            "type": "_bluetti._tcp.local.",
            "name": "balco260*"
        },
        {
            "type": "_http._tcp.local.",
            "name": "bluetti hems*"
        }
    ]
}
